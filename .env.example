# Copy to .env.local and fill in when you're ready to move off mock data.
# Nothing here is required to run `npm run dev` - the app defaults to the
# fixtures in lib/mock when a given integration's env vars are absent.

# --- Database (Section 7.1 / 8) ---------------------------------------------
# Postgres connection string. Only needed once you run `npm run db:migrate`.
DATABASE_URL="postgresql://user:password@localhost:5432/edgehub"

# --- Runtime mode ------------------------------------------------------------
# "true" (default) serves every screen from lib/mock fixtures instead of the
# database/providers below. Flip to "false" once real integrations are wired.
USE_MOCK_DATA="true"

# --- Odds data provider (Section 7.2) ---------------------------------------
ODDS_PROVIDER_API_KEY=""
ODDS_PROVIDER_BASE_URL="https://api.the-odds-api.com/v4"

# --- Auth provider (Section 7.1) --------------------------------------------
# Server AND client both need to agree on the mode - NEXT_PUBLIC_AUTH_PROVIDER
# drives client components (sign-up/sign-in forms), AUTH_PROVIDER drives
# server-side session resolution (middleware, auth()). Keep them in sync.
AUTH_PROVIDER="mock" # "mock" | "clerk"
NEXT_PUBLIC_AUTH_PROVIDER="mock" # "mock" | "clerk"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# --- Billing (Section 7.1 / 11) ---------------------------------------------
# "mock" (default) lets the client PATCH the plan directly - no real payment
# ever happens. "stripe" routes plan changes through real Checkout/Portal
# sessions and makes the plan-change PATCH endpoint refuse direct writes -
# in real billing, Stripe's webhook is the only thing allowed to change plan.
BILLING_PROVIDER="mock" # "mock" | "stripe"
NEXT_PUBLIC_BILLING_PROVIDER="mock" # "mock" | "stripe" - keep in sync with BILLING_PROVIDER above
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_ELITE=""
# Where Checkout/Portal sessions send the user back to - defaults to
# NEXT_PUBLIC_APP_URL + /account if unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI explanations (Section 9) --------------------------------------------
OPENAI_API_KEY=""

# --- Real-time push (Section 7.1) -------------------------------------------
# Unset (default): odds-tick push (lib/realtime/bus.ts) uses an in-process
# EventEmitter - fine for one running instance, which is all mock mode or a
# single-container deployment ever has. Set this once you have more than
# one thing that needs to publish or receive ticks across process
# boundaries - e.g. the ingestion CLI (scripts/ingest.ts) notifying a
# separately-running web server, or multiple web server instances behind a
# load balancer. Live-verified in this environment with a temporary Redis
# container: a genuinely separate Node process publishing was received by
# the running web server's SSE stream. See DEPLOYMENT.md.
REDIS_URL=""
